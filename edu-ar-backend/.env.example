DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="generate-a-random-secret-at-least-32-characters"
PORT=5000
CORS_ORIGINS="http://localhost:3000,https://your-frontend.vercel.app"
BLOB_READ_WRITE_TOKEN="created-automatically-when-you-connect-a-Blob-store"

# Optional for local development with a public tunnel:
# VERCEL_BLOB_CALLBACK_URL="https://your-tunnel.example/api/uploads/client"

# Required only when running npm run seed to create the first admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-strong-unique-password"
